# Required
SETTLER_RPC_URL=https://mainnet.base.org
# Or set SETTLER_PRIVATE_KEY_FILE to a mounted secret instead of SETTLER_PRIVATE_KEY
SETTLER_PRIVATE_KEY=0x...
# Required for /keys and /status; they are disabled when unset
ADMIN_TOKEN=change-me

# Optional
SETTLER_CHAIN_ID=8453
SETTLER_API_KEYS=key1,key2
SETTLER_MAX_CALLS_PER_TX=400
SETTLER_GAS_MULTIPLIER=1.1
SETTLER_FEE_ENABLED=false
SETTLER_FEE_AMOUNT=100000
SETTLER_RATE_LIMIT=10
SETTLER_MAX_FEE_GWEI=50
SETTLER_MIN_VALUE=1
SETTLER_MAX_KEYS=1000
SETTLER_KEYS_FILE=/data/keys.json
SETTLER_TOKEN_ALLOWLIST=
SETTLER_PAYEE_ALLOWLIST=
SETTLER_CORS_ORIGINS=
SETTLER_LOG_LEVEL=info
